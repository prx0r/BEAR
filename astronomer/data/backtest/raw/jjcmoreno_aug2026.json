etweeted_tweet": null}, {"type": "tweet", "id": "2087891482707403152", "url": "https://x.com/jjcmoreno/status/2087891482707403152", "twitterUrl": "https://twitter.com/jjcmoreno/status/2087891482707403152", "text": "The Trader's On-chain Realized Price has continued to be a resistance for Bitcoin, today at $65.6K\n\nKey level to watch.\n\nLive chart: https://t.co/IHO8ws1g5w https://t.co/kCMBaH9zP5", "source": "Twitter Web App", "retweetCount": 9, "replyCount": 0, "likeCount": 30, "quoteCount": 1, "viewCount": 10796, "createdAt": "Thu Aug 13 13:18:15 +0000 2026", "lang": "en", "bookmarkCount": 4, "isReply": false, "inReplyToId": null, "conversationId": "2087891482707403152", "media": [{"type": "photo", "url": "https://pbs.twimg.com/media/HPmtvR-WcAAcAD3.jpg", "expanded_url": "https://x.com/jjcmoreno/status/2087891482707403152/photo/1", "video_url": null}], "inReplyToUserId": null, "author": {"type": "user", "userName": "jjcmoreno", "url": "https://x.com/jjcmoreno", "id": "857391241", "name": "Julio Moreno", "isVerified": false, "isBlueVerified": true, "profilePicture": "https://pbs.twimg.com/profile_images/1760455917244428288/qCePB8rP_normal.jpg", "coverPicture": "https://pbs.twimg.com/profile_banners/857391241/1705586919", "description": "Head of Research @CryptoQuant_com | Data-driven analysis of Bitcoin and digital assets.", "location": "San Salvador, El Salvador", "followers": 23209, "following": 1302, "createdAt": "Tue Oct 02 02:43:10 +0000 2012", "canDm": true}, "quoted_tweet": null, "retweeted_tweet": null}, {"type": "tweet", "id": "2086852630353994135", "url": "https://x.com/jjcmoreno/status/2086852630353994135", "twitterUrl": "https://twitter.com/jjcmoreno/status/2086852630353994135", "text": "Most of the BTC stolen by the coldcard hackers sit on a few addresses.\n\nThe top 5 attacker addresses by current BTC balance concentrate almost 83% of the confirmed stolen funds, or 1,127 BTC. \n\nCheck the data and addresses on our live dashboard: https://t.co/tS7aR87ZK6 https://t.co/ZxndLB2mo5", "source": "Twitter Web App", "retweetCount": 10, "replyCount": 2, "likeCount": 46, "quoteCount": 1, "viewCount": 7966, "createdAt": "Mon Aug 10 16:30:13 +0000 2026", "lang": "en", "bookmarkCount": 1, "isReply": false, "inReplyToId": null, "conversationId": "2086852630353994135", "media": [{"type": "photo", "url": "https://pbs.twimg.com/media/HPX8wf-WQAAtQSv.jpg", "expanded_url": "https://x.com/jjcmoreno/status/2086852630353994135/photo/1", "video_url": null}], "inReplyToUserId": null, "author": {"type": "user", "userName": "jjcmoreno", "url": "https://x.com/jjcmoreno", "id": "857391241", "name": "Julio Moreno", "isVerified": false, "isBlueVerified": true, "profilePicture": "https://pbs.twimg.com/profile_images/1760455917244428288/qCePB8rP_normal.jpg", "coverPicture": "https://pbs.twimg.com/profile_banners/857391241/1705586919", "description": "Head of Research @CryptoQuant_com | Data-driven analysis of Bitcoin and digital assets.", "location": "San Salvador, El Salvador", "followers": 23209, "following": 1302, "createdAt": "Tue Oct 02 02:43:10 +0000 2012", "canDm": true}, "quoted_tweet": null, "retweeted_tweet": null}, {"type": "tweet", "id": "2085513651251793973", "url": "https://x.com/jjcmoreno/status/2085513651251793973", "twitterUrl": "https://twitter.com/jjcmoreno/status/2085513651251793973", "text": "No.\n\nPor ejemplo, tu puedes retirar 1 BTC, pero no sabes cuantos UTxOs te manda el exchange para completar ese 1 BTC y de que valor va a ser cada UTxO. \n\nPuede que te mande varios UTxOs de diferente denominaci\u00f3n. \n\nDe la misma forma que no sabes cuantos billetes y de que denominaci\u00f3n te va a dar un cajero autom\u00e1tico cuando haces un retiro de efectivo. Depende de lo que tenga el cajero en ese momento.", "source": "Twitter Web App", "retweetCount": 0, "replyCount": 1, "likeCount": 2, "quoteCount": 0, "viewCount": 110, "createdAt": "Thu Aug 06 23:49:36 +0000 2026", "lang": "es", "bookmarkCount": 0, "isReply": true, "inReplyToId": "2085493390804738340", "conversationId": "2085486460409455043", "media": [], "inReplyToUserId": "1491969679622955012", "author": {"type": "user", "userName": "jjcmoreno", "url": "https://x.com/jjcmoreno", "id": "857391241", "name": "Julio Moreno", "isVerified": false, "isBlueVerified": true, "profilePicture": "https://pbs.twimg.com/profile_images/1760455917244428288/qCePB8rP_normal.jpg", "coverPicture": "https://pbs.twimg.com/profile_banners/857391241/1705586919", "description": "Head of Research @CryptoQuant_com | Data-driven analysis of Bitcoin and digital assets.", "location": "San Salvador, El Salvador", "followers": 23209, "following": 1302, "createdAt": "Tue Oct 02 02:43:10 +0000 2012", "canDm": true}, "quoted_tweet": null, "retweeted_tweet": null}, {"type": "tweet", "id": "2085492461829492947", "url": "https://x.com/jjcmoreno/status/2085492461829492947", "twitterUrl": "https://twitter.com/jjcmoreno/status/2085492461829492947", "text": "En la pr\u00e1ctica, cuantos UTxOs tengas en tu wallet depende de c\u00f3mo maneje el exchange su propia wallet.\n\nEn un exchange, tu ves el total de tu balance, pero, al retirar tu Bitcoin del exchange, te pueden enviar varios UTxOs para completar el total de los BTC retirados y  los UTxOs ser\u00e1n de diferentes denominaciones.\n\nRara vez, por no decir que nunca, the enviaran 1 UTxO por el total de tu balance.", "source": "Twitter Web App", "retweetCount": 0, "replyCount": 1, "likeCount": 3, "quoteCount": 0, "viewCount": 506, "createdAt": "Thu Aug 06 22:25:24 +0000 2026", "lang": "es", "bookmarkCount": 0, "isReply": true, "inReplyToId": "2085486460409455043", "conversationId": "2085486460409455043", "media": [], "inReplyToUserId": "1491969679622955012", "author": {"type": "user", "userName": "jjcmoreno", "url": "https://x.com/jjcmoreno", "id": "857391241", "name": "Julio Moreno", "isVerified": false, "isBlueVerified": true, "profilePicture": "https://pbs.twimg.com/profile_images/1760455917244428288/qCePB8rP_normal.jpg", "coverPicture": "https://pbs.twimg.com/profile_banners/857391241/1705586919", "description": "Head of Research @CryptoQuant_com | Data-driven analysis of Bitcoin and digital assets.", "location": "San Salvador, El Salvador", "followers": 23209, "following": 1302, "createdAt": "Tue Oct 02 02:43:10 +0000 2012", "canDm": true}, "quoted_tweet": null, "retweeted_tweet": null}, {"type": "tweet", "id": "2085048543593570707", "url": "https://x.com/jjcmoreno/status/2085048543593570707", "twitterUrl": "https://twitter.com/jjcmoreno/status/2085048543593570707", "text": "Join us now in this space as we discuss TRON beyond P2P.", "source": "Twitter Web App", "retweetCount": 0, "replyCount": 0, "likeCount": 5, "quoteCount": 0, "viewCount": 2924, "createdAt": "Wed Aug 05 17:01:25 +0000 2026", "lang": "en", "bookmarkCount": 0, "isReply": false, "inReplyToId": null, "conversationId": "2085048543593570707", "media": [], "inReplyToUserId": null, "author": {"type": "user", "userName": "jjcmoreno", "url": "https://x.com/jjcmoreno", "id": "857391241", "name": "Julio Moreno", "isVerified": false, "isBlueVerified": true, "profilePicture": "https://pbs.twimg.com/profile_images/1760455917244428288/qCePB8rP_normal.jpg", "coverPicture": "https://pbs.twimg.com/profile_banners/857391241/1705586919", "description": "Head of Research @CryptoQuant_com | Data-driven analysis of Bitcoin and digital assets.", "location": "San Salvador, El Salvador", "followers": 23209, "following": 1302, "createdAt": "Tue Oct 02 02:43:10 +0000 2012", "canDm": true}, "quoted_tweet": {"id": "2085028290968826301", "text": "TRON is moving beyond P2P value transfer.\n\nGasless rails. Cross-chain liquidity powering live payment businesses. AI agents settling transactions machine-to-machine.\n\nHere's the data on how @trondao is becoming an infrastructure layer, not just a transfer rail. \ud83e\uddf5 https://t.co/7PVGRMAvxQ", "user": {"name": "CryptoQuant.com", "screen_name": "cryptoquant_com"}}, "retweeted_tweet": null}, {"type": "tweet", "id": "2084679380710637734", "url": "https://x.com/jjcmoreno/status/2084679380710637734", "twitterUrl": "https://twitter.com/jjcmoreno/status/2084679380710637734", "text": "If there's a silver lining to this whole Coldcard hack mess, it's that the awareness raised by so many people urging others to move their funds seems to be working.\n\nAll on-chain metrics show a surge in network activity (active addresses, transfers from small holders, exchange inflows, transactions on the mempool, etc.) as Bitcoin holders rushed to move their funds to safety. Still, it is hard, if not impossible, to know how much Bitcoin remains at risk.\n\nI know this is no consolation for the people who lost their hard-earned savings, but it's a small win for the industry in the midst of the Coldcard hack.\n\nSee the full report here: https://t.co/KjBRetaUft", "source": "Twitter Web App", "retweetCount": 4, "replyCount": 2, "likeCount": 39, "quoteCount": 0, "viewCount": 6248, "createdAt": "Tue Aug 04 16:34:30 +0000 2026", "lang": "en", "bookmarkCount": 5, "isReply": false, "inReplyToId": null, "conversationId": "2084679380710637734", "media": [{"type": "photo", "url": "https://pbs.twimg.com/media/HO4_FzPWoAAdfa-.jpg", "expanded_url": "https://x.com/jjcmoreno/status/2084679380710637734/photo/1", "video_url": null}], "inReplyToUserId": null, "author": {"type": "user", "userName": "jjcmoreno", "url": "https://x.com/jjcmoreno", "id": "857391241", "name": "Julio Moreno", "isVerified": false, "isBlueVerified": true, "profilePicture": "https://pbs.twimg.com/profile_images/1760455917244428288/qCePB8rP_normal.jpg", "coverPicture": "https://pbs.twimg.com/profile_banners/857391241/1705586919", "description": "Head of Research @CryptoQuant_com | Data-driven analysis of Bitcoin and digital assets.", "location": "San Salvador, El Salvador", "followers": 23209, "following": 1302, "createdAt": "Tue Oct 02 02:43:10 +0000 2012", "canDm": true}, "quoted_tweet": null, "retweeted_tweet": null}, {"type": "tweet", "id": "2083768184176324737", "url": "https://x.com/jjcmoreno/status/2083768184176324737", "twitterUrl": "https://twitter.com/jjcmoreno/status/2083768184176324737", "text": "The Bitcoin plebs had not move this amount of BTC in a day since the FTX collapse.\n\n39.6K BTC transferred on July 31st after the coldcard hack, 39.9K BTC transferred on November 16 2022, a few days after the FTX collapse.\n\nThese are Bitcoin transfers < 1 BTC.\n\nI like to see that people seem to be taking action.", "source": "Twitter Web App", "retweetCount": 8, "replyCount": 11, "likeCount": 104, "quoteCount": 5, "viewCount": 14082, "createdAt": "Sun Aug 02 04:13:44 +0000 2026", "lang": "en", "bookmarkCount": 15, "isReply": false, "inReplyToId": null, "conversationId": "2083768184176324737", "media": [{"type": "photo", "url": "https://pbs.twimg.com/media/HOsHK_6XwAA0DbC.jpg", "expanded_url": "https://x.com/jjcmoreno/status/2083768184176324737/photo/1", "video_url": null}], "inReplyToUserId": null, "author": {"type": "user", "userName": "jjcmoreno", "url": "https://x.com/jjcmoreno", "id": "857391241", "name": "Julio Moreno", "isVerified": false, "isBlueVerified": true, "profilePicture": "https://pbs.twimg.com/profile_images/1760455917244428288/qCePB8rP_normal.jpg", "coverPicture": "https://pbs.twimg.com/profile_banners/857391241/1705586919", "description": "Head of Research @CryptoQuant_com | Data-driven analysis of Bitcoin and digital assets.", "location": "San Salvador, El Salvador", "followers": 23209, "following": 1302, "createdAt": "Tue Oct 02 02:43:10 +0000 2012", "canDm": true}, "quoted_tweet": null, "retweeted_tweet": null}, {"type": "tweet", "id": "2083761258466038107", "url": "https://x.com/jjcmoreno/status/2083761258466038107", "twitterUrl": "https://twitter.com/jjcmoreno/status/2083761258466038107", "text": "Seems people really moved their Bitcoin out of extreme caution after the coldcard hack.\n\nBitcoin daily active addresses spiked from 645k on July 